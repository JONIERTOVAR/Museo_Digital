datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  VISITANTE
  ESTUDIANTE
  DOCENTE
  ADMINISTRADOR
}

enum Status {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model User {
  id        String    @id @default(uuid())
  nombre    String
  email     String    @unique
  password  String
  role      Role      @default(ESTUDIANTE)
  points    Int       @default(0)
  contents  Content[]
  createdAt DateTime  @default(now())
}

model Content {
  id           String   @id @default(uuid())
  title        String
  description  String
  category     String
  year         Int
  imageUrl     String?
  status       Status   @default(PENDIENTE)
  observations String?
  authorId     String
  author       User     @relation(fields: [authorId], references: [id])
  createdAt    DateTime @default(now())
}